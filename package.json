{
  "name": "weak-ref-map",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "pnpm run -s test:typecheck && pnpm run -s test:vitest",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:vitest": "node --no-concurrent-marking --no-concurrent-sweeping --expose-gc --gc-interval=100 node_modules/vitest/vitest.mjs run"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/seedrandom": "^3.0.8",
    "fast-check": "^4.10.1",
    "seedrandom": "^3.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
